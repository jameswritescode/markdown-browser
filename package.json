{
  "name": "@jamesnewton/mdb",
  "version": "0.2.0",
  "description": "A markdown browser for the terminal, drawn with real pixels.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jameswritescode/markdown-browser.git"
  },
  "bin": {
    "mdb": "bin/mdb.js"
  },
  "files": [
    "bin",
    "dist",
    "skill",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "main": "dist/main/main.js",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "build": "node scripts/build.mjs",
    "prepack": "pnpm build",
    "smoke": "pnpm build && node scripts/smoke.mjs",
    "test:page": "pnpm build && vitest run --config vitest.page.config.mts",
    "test:all": "pnpm test && pnpm test:page"
  },
  "dependencies": {
    "@zenbu-labs/pixel": "0.3.4",
    "highlight.js": "11.12.0",
    "ignore": "7.0.16",
    "markdown-it": "15.0.3",
    "markdown-it-anchor": "10.1.0",
    "markdown-it-footnote": "4.0.0",
    "markdown-it-task-lists": "2.1.1",
    "pele": "1.13.0",
    "react": "18.3.1",
    "sanitize-html": "2.18.2",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.31",
    "@types/sanitize-html": "2.16.2",
    "esbuild": "0.28.2",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@12.6.0"
}
