{
  "args": ["../docs/showcase.md", "--heading", "tables"],
  "out": "../build/tophat/remote",
  "width": 1000,
  "height": 600,
  "steps": [
    { "wait": 1500 },
    {
      "eval": "[document.querySelector('.reader-scroll').scrollTop > 0, Math.round(document.getElementById('tables').getBoundingClientRect().top)]"
    },
    { "shot": "start-heading" },
    {
      "eval": "window.mdbRemote.open(document.querySelector('.reader-scroll') && location.pathname.replace(/dist\\/page\\/index.html$/, 'docs/usage.md'), 'Outline')"
    },
    { "wait": 500 },
    {
      "eval": "[document.title, Math.round(document.getElementById('outline').getBoundingClientRect().top)]"
    },
    {
      "eval": "window.mdbRemote.open(location.pathname.replace(/dist\\/page\\/index.html$/, 'docs/showcase.md'), 'Nothing like this')"
    },
    { "wait": 300 },
    {
      "eval": "[document.querySelector('.reader-scroll').scrollTop, document.querySelector('.where').textContent]"
    },
    { "shot": "missing-heading" },
    { "key": "[", "modifiers": ["control"] },
    { "wait": 500 },
    { "eval": "document.title" }
  ]
}
