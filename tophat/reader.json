{
  "args": ["../test/fixtures/docs/README.md"],
  "out": "../build/tophat/reader",
  "width": 1200,
  "height": 900,
  "steps": [
    {
      "wait": 600
    },
    {
      "eval": "document.querySelector('.reader-content').classList.contains('with-outline')",
      "expect": false
    },
    {
      "key": "b",
      "modifiers": ["control"]
    },
    {
      "eval": "document.querySelector('.reader-content').classList.contains('with-outline')",
      "expect": true
    },
    {
      "shot": "1-top"
    },
    {
      "eval": "document.querySelector('.outline a.active')?.textContent",
      "expect": "Fixture Docs"
    },
    {
      "scroll": 700
    },
    {
      "shot": "2-middle"
    },
    {
      "eval": "document.querySelector('.outline a.active')?.textContent",
      "expect": "Notes"
    },
    {
      "eval": "document.querySelector('.diagram svg') ? 'svg' : document.querySelector('.diagram')?.textContent",
      "expect": "svg"
    },
    {
      "key": "b",
      "modifiers": ["control"]
    },
    {
      "shot": "3-outline-hidden"
    },
    {
      "key": "b",
      "modifiers": ["control"]
    },
    {
      "key": "g"
    },
    {
      "click": "a[href='guide/setup.md']"
    },
    {
      "wait": 300
    },
    {
      "eval": "document.title",
      "expect": "Setup Guide"
    },
    {
      "shot": "4-linked-doc"
    },
    {
      "key": "[",
      "modifiers": ["meta"]
    },
    {
      "wait": 300
    },
    {
      "eval": "document.title",
      "expect": "Fixture Docs"
    },
    {
      "key": "]",
      "modifiers": ["control"]
    },
    {
      "wait": 300
    },
    {
      "eval": "document.title",
      "expect": "Setup Guide"
    },
    {
      "key": "[",
      "modifiers": ["control"]
    },
    {
      "wait": 300
    },
    {
      "eval": "document.title",
      "expect": "Fixture Docs"
    },
    {
      "click": "a[href='missing.md']"
    },
    {
      "eval": "document.querySelector('.link-notice')?.textContent",
      "expect": "Not found: missing.md"
    },
    {
      "key": "Escape"
    },
    {
      "wait": 800
    },
    {
      "eval": "document.querySelector('.finder') && !document.querySelector('.finder').hidden",
      "expect": true
    },
    {
      "shot": "5-finder-after-esc"
    }
  ]
}
